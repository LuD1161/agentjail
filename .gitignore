# Build outputs
/bin/
/dist/

# Editor / OS noise
.DS_Store
.vscode/
.idea/

# Claude harness state (worktrees, transient agent IO)
/.claude/

# Local Claude Code config (personal prefs; @-imports AGENTS.md)
/CLAUDE.md

# Local environment
.env
.env.*
!.env.example

# Python bytecode (mitmproxy addon side-effect)
__pycache__/
*.pyc

# Web UI generated artifacts
cmd/agentjail/ui/frontend/node_modules/
cmd/agentjail/ui/static/dist/

# dev-install build output
/build/

# Build artifacts (root-level binaries from `go build .`)
/agentjail
/agentjail-shield
/agentjail-hook
/agentjail-daemon
/agentjail-netproxy

# Firecracker spike rootfs (89MB binary — never commit)
/.rootfs-work/
/assets/rootfs.img
/agentjail/research/firecracker-spike/assets/

# Local, per-developer tooling and scratch space — never committed.
.dev-local/

# Manus-style planning scratch (internal task plans / acceptance notes) — local only.
.planning/

# Remotion video workspace
video/node_modules/
video/out/

# HyperFrames experiment ports (local-only, large render/asset trees)
video-hf-glass/
video-hf-kinetic/
video-hf-shield/
video-hyperframes/

# Internal design specs / brainstorming notes — local only, never shipped public.
docs/superpowers/

# Generated code-review output — local only, never shipped public.
# NOTE: drafts/ and plans/ are deliberately NOT ignored; both are tracked
# directories. Untracked files there are work-in-progress, not local-only —
# stage them by path rather than with `git add -A`.
docs/reviews/

# UI testing screenshots (local only)
screenshots/

# testbed recordings (generated)
/test/testbed/reports/
