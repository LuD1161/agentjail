[1.227, "o", "   PASS  core-rule disable guarded (needs --force/TTY)\r\n"]
[1.227, "o", "\r\n"]
[1.227, "o", "===================================================================\r\n  7. secret \u2014 set / list / remove\r\n===================================================================\r\n"]
[1.227, "o", "   FINDING  agentjail-secrets vault binary is NOT shipped in this install (checked $HOME/.agentjail/bin and $PATH).\r\n   FINDING  'secret set/remove' depend on it and cannot function without it \u2014 this is a real packaging gap, not a test bug.\r\n"]
