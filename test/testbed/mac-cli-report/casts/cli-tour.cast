[6.49, "o", "\r\n$ agentjail allow host api.example.com\r\n"]
[6.515, "o", "requested host api.example.com (ttl 1h) - pending human approval (grant_id 80caeebca3a9e69fa0a97b76311ba661); run 'agentjail grants' in a trusted terminal to approve\r\n"]
[6.515, "o", "  -> exit 0\r\n"]
[6.515, "o", "\r\n===================================================================\r\n"]
[6.516, "o", "  12. telemetry \u2014 view / disable / enable\r\n===================================================================\r\n"]
[6.516, "o", "\r\n$ agentjail telemetry view\r\n"]
[6.538, "o", "[\r\n  {\r\n    \"event\": \"feature_used\",\r\n    \"properties\": {\r\n      \"$insert_id\": \"f03950c1-3f5c-472f-a0dd-5e36aaeb10a1\",\r\n      \"agentjail_version\": \"dev-add2fa0a\",\r\n      \"command\": \"install\",\r\n      \"distinct_id\": \"51cdae1bf171ec42a34592a80e8b6d195ee5fddef5c5625ad94ce69adf482a8e\"\r\n    },\r\n    \"$set\": {\r\n      \"agentjail_version\": \"dev-add2fa0a\"\r\n    }\r\n  },\r\n  {\r\n    \"event\": \"policy_config\",\r\n    \"properties\": {\r\n      \"$insert_id\": \"8ac61c45-e6f2-4b57-b563-273447375a46\",\r\n      \"agentjail_version\": \"dev-add2fa0a\",\r\n      \"custom_rule_count\": 0,\r\n      \"disabled_rules\": null,\r\n      \"distinct_id\": \"51cdae1bf171ec42a34592a80e8b6d195ee5fddef5c5625ad94ce69adf482a8e\"\r\n    },\r\n"]
[6.538, "o", "  -> exit 0\r\n"]
[6.539, "o", "\r\n$ agentjail telemetry disable\r\n"]
