[0.054, "o", "  time: 2026-07-10 05:35:26 UTC\r\n"]
[0.055, "o", "\r\n"]
[0.083, "o", "###################################################################\r\n"]
[0.095, "o", "#  agentjail CLI tour \u2014                                        \r\n"]
[0.103, "o", "#  host: Darwin arm64  user: admin  Fri 10 Jul 2026 05:35:26 UTC\r\n###################################################################\r\n"]
[0.103, "o", "\r\n"]
[0.103, "o", "===================================================================\r\n  1. Version / health / diagnostics\r\n===================================================================\r\n"]
[0.103, "o", "\r\n$ agentjail version\r\n"]
[0.118, "o", "                                       \r\n  \u2588 \u2588 \u2588  AgentJail                     \r\n  \u2588 \u2588 \u2588  policy guardrails for agents  \r\n  \u2588 \u2588 \u2588  dev-add2fa0a \u00b7 darwin         \r\n                                       \r\n"]
[0.118, "o", "  -> exit 0\r\n"]
[0.118, "o", "\r\n$ agentjail status\r\n"]
[0.138, "o", "                                       \r\n  \u2588 \u2588 \u2588  AgentJail                     \r\n  \u2588 \u2588 \u2588  policy guardrails for agents  \r\n  \u2588 \u2588 \u2588  dev-add2fa0a \u00b7 darwin         \r\n                                       \r\n\r\n\u276f \ud83e\uddf1  Infrastructure\r\n      hook binary         \u2713 ok\r\n      daemon binary       \u2713 ok\r\n      policy.yaml         \u2713 ok\r\n      launchd plist       \u2713 ok\r\n      daemon              \u2713 running\r\n\r\n\u276f \ud83d\udd0c  Agent hooks\r\n      Claude Code         \u2713 detected (~/.claude exists)  \u2713 installed\r\n      Cursor              \u2717 not detected  \u2717 not installed\r\n      Codex               \u2717 not detected  \u2717 not installed\r\n        note: hooks.json not found or unreadable\r\n        note: config.toml not found (features.hooks unknown)\r\n        note: grant trust once in Codex: run /hooks (agentjail can't read Codex trust state)\r\n"]
[0.138, "o", "  -> exit 0\r\n"]
[0.138, "o", "\r\n$ agentjail doctor\r\n"]
[0.153, "o", "Platform\r\n  [ok]  OS                             darwin/arm64\r\n  [ok]  Seatbelt                       available\r\n\r\nShield\r\n  [ok]  agentjail-shield               /Users/admin/.agentjail/bin/agentjail-shield\r\n\r\nDaemon\r\n  [ok]  Socket                         connected\r\n\r\nHooks\r\n  [ok]  Hook binary                    /Users/admin/.agentjail/bin/agentjail-hook\r\n  [ok]  Claude Code                    hook installed\r\n\r\nLaunch Integration\r\n  [-]   PATH shim                      not installed (opt-in: agentjail install --with-path-shim)\r\n  [-]   Code wrapper                   Code not detected\r\n  [-]   Cursor wrapper                 Cursor not detected\r\n\r\nAll checks passed.\r\n"]
[0.154, "o", "  -> exit 0\r\n"]
[0.154, "o", "   PASS  install present (~/.agentjail)\r\n\r\n===================================================================\r\n  2. Policy \u2014 inspection\r\n"]
[0.154, "o", "===================================================================\r\n"]
[0.154, "o", "\r\n$ agentjail policy list\r\n"]
[0.17, "o", "\u276f Core Rules\r\n  \u2713 on                   aws_policy/posture                       Per-account AWS posture: sandbox asks on delete, prod denies delete, locked denies CUD; fails safe to prod\r\n  \u2713 on                   command_policy/no-sudo                   Block sudo invocations\r\n  \u2713 on                   command_policy/no-rm-rf-absolute         Block rm -rf on absolute paths\r\n  \u2713 on                   command_policy/no-git-push-force         Block git force-push to the default branch (main/master)\r\n  \u2713 on                   command_policy/no-chmod-777              Block chmod 777 / world-write operations\r\n  \u2713 on                   command_policy/no-dd-device-read         Block dd reads from raw block devices\r\n  \u2713 on                   command_policy/no-device-overwrite       Block writes to raw block/char devices\r\n  \u2713 on                   command_policy/no-env-exfil              Block environment-variable exfiltration via curl/wget\r\n  \u2713 on                   command_policy/no-gpg-secret-export    "]
[0.17, "o", "  Block GPG secret key export\r\n"]
[0.17, "o", "  \u2713 on                   command_policy/no-launchctl-remove       Block launchctl remove / unload of system services\r\n  \u2713 on                   command_policy/no-pipe-to-shell          Block curl/wget | sh pipe-to-shell patterns\r\n  \u2713 on                   command_policy/no-ssh-keygen-outside-tmp Block ssh-keygen writing keys outside /tmp\r\n  \u2713 on                   command_policy/no-systemctl-disrupt      Block systemctl stop/disable/mask on critical services\r\n  \u2713 on                   command_policy/no-bash-touch-sensitive-path Block bash touch/truncation of sensitive paths\r\n  \u2713 on                   command_policy/confirm-curl-download     Ask before downloading via curl (non-pipe)\r\n  \u2713 on                   command_policy/confirm-git-push          Ask before git push to a remote\r\n  \u2713 on                   command_policy/confirm-git-push-force    Ask before a force-push whose target branch is implicit (bare git push -f)\r\n  \u2713 on                   command_policy/confirm-publish           Ask before "]
[0.17, "o", "npm/cargo/pip publish\r\n  \u2713 on                   command_policy/default-allow             Allow commands that match no other rule\r\n  locked                 command_policy/no-policy-mutation        Block agents from running agentjail policy/mcp mutation commands\r\n  locked                 file_policy/agentjail_self               Block reads/writes to ~/.agentjail/ (agentjail self-protection)\r\n"]
[0.17, "o", "  -> exit 0\r\n"]
[0.17, "o", "\r\n===================================================================\r\n  3. try \u2014 enforcement decisions (dry-run)\r\n"]
[0.17, "o", "===================================================================\r\n"]
[0.17, "o", "\r\n$ agentjail try --write ~/.ssh/authorized_keys\r\n"]
[0.2, "o", "  Write     /Users/admin/.ssh/authorized_keys                             \u2717 deny  file_policy/sensitive_credential  would access sensitive path \"/Users/admin/.ssh/au\u2026\r\n"]
[0.201, "o", "  -> exit 0\r\n"]
[0.215, "o", "   PASS  try --write /Users/admin/.ssh/authorized_keys -> deny\r\n"]
[0.23, "o", "   PASS  try --write /Users/admin/.aws/credentials -> deny\r\n"]
[0.244, "o", "   PASS  try --read /Users/admin/.ssh/id_rsa -> deny\r\n"]
[0.259, "o", "   PASS  try --write /Users/admin/work/demo/note.txt -> allow\r\n"]
[0.274, "o", "   PASS  try --read /Users/admin/work/demo/README.md -> allow\r\n"]
[0.288, "o", "   PASS  try sudo rm -rf / -> deny\r\n"]
[0.302, "o", "   PASS  try rm -rf / -> deny\r\n"]
[0.315, "o", "   PASS  try chmod 777 /etc/hosts -> deny\r\n"]
[0.315, "o", "\r\n$ agentjail try --json (sample)\r\n"]
[0.332, "o", "{\"tool\":\"Write\",\"input\":\"/Users/admin/.ssh/authorized_keys\",\"action\":\"deny\",\"rule_id\":\"file_policy/sensitive_credential\",\"reason\":\"access to sensitive path \\\"/Users/admin/.ssh/authorized_keys\\\" is denied by file policy\",\"impact\":\"would access sensitive path \\\"/Users/admin/.ssh/authorized_keys\\\"\"}\r\n"]
[0.333, "o", "  -> exit 0\r\n"]
[0.333, "o", "\r\n===================================================================\r\n  4. run \u2014 execute inside the shield\r\n===================================================================\r\n"]
[0.333, "o", "\r\n$ agentjail run -- echo hello-from-shield\r\n"]
[0.653, "o", "agentjail: starting shielded session for echo\r\nhello-from-shield\r\n"]
[0.653, "o", "  -> exit 0\r\n"]
[0.653, "o", "$ agentjail run -- cat ~/.ssh/id_rsa   (shield should block the read)\r\n"]
[0.765, "o", "   PASS  shield blocked private-key read via run\r\n"]
[0.765, "o", "\r\n"]
[0.765, "o", "===================================================================\r\n  5. mcp \u2014 allow / block / inspect\r\n"]
[0.765, "o", "===================================================================\r\n"]
[0.765, "o", "\r\n$ agentjail mcp list\r\n"]
[0.782, "o", "\u276f Installed MCP servers\r\n  \u2713 chrome-devtools  allowed\r\n  \u2713 linear-server    allowed\r\n\r\n\u276f MCP allowed\r\n  chrome-devtools\r\n  linear-server\r\n\r\n\u276f MCP blocked\r\n  *stripe*\r\n  *payment*\r\n  *billing*\r\n  *twilio*\r\n  *sendgrid*\r\n"]
[0.782, "o", "  -> exit 0\r\n"]
[0.782, "o", "\r\n$ agentjail mcp tools\r\n"]
[0.799, "o", "no MCP tool data found -- run 'agentjail mcp scan' first to populate the audit database\r\n"]
[0.799, "o", "  -> exit 0\r\n"]
[0.799, "o", "\r\n$ agentjail mcp where linear-server\r\n"]
[0.822, "o", "\r\n\u276f \ud83d\udd0d  MCP server \"linear-server\" is used in:\r\n\r\n  \u276f Global Config\r\n  \u2713 ~ (user-installed)\r\n\r\n  Not found in: 1 other known project(s)\r\n"]
[0.823, "o", "  -> exit 0\r\n"]
[0.823, "o", "\r\n$ agentjail mcp scan\r\n"]
[1.056, "o", "\r\n\u276f \ud83d\udd0d  MCP Server Scan\r\n\r\n\u276f Configured Servers (from agent configs)\r\n  \u2713 chrome-devtools  stdio   global    user-installed          npx\r\n  \u2713 linear-server    http    global    user-installed          \r\n\r\n  Summary: 2 configured, 0 installed (not configured), 0 docker, 0 audit-only, 0 remote connector(s)\r\n"]
[1.056, "o", "  -> exit 0\r\n"]
[1.056, "o", "\r\n--- mutate (non-TTY): allow 'context7', block 'evilcorp' \u2014 MUST be refused ---\r\n"]
[1.056, "o", "\r\n$ agentjail mcp allow context7\r\n"]
[1.072, "o", "agentjail mcp allow: REFUSED \u2014 no interactive terminal detected.\r\n  Changing the MCP allow/block list mutates agentjail's own policy.\r\n  It must be run in a terminal by a human.\r\n  This restriction prevents an agent from self-approving an MCP server.\r\n"]
[1.072, "o", "  -> exit 1\r\n"]
[1.076, "o", "   PASS  mcp allow context7 -> correctly REFUSED (non-TTY self-approval guard)\r\n"]
[1.076, "o", "\r\n$ agentjail mcp block evilcorp\r\n"]
[1.091, "o", "agentjail mcp block: REFUSED \u2014 no interactive terminal detected.\r\n  Changing the MCP allow/block list mutates agentjail's own policy.\r\n  It must be run in a terminal by a human.\r\n  This restriction prevents an agent from self-approving an MCP server.\r\n"]
[1.091, "o", "  -> exit 1\r\n"]
[1.095, "o", "   PASS  mcp block evilcorp -> correctly REFUSED (non-TTY self-approval guard)\r\n"]
[1.095, "o", "\r\n===================================================================\r\n  6. policy \u2014 add / remove / disable-guard\r\n"]
[1.095, "o", "===================================================================\r\n"]
[1.097, "o", "\r\n$ agentjail policy add /tmp/tour-custom-rule.rego\r\n"]
[1.157, "o", "added: tour-custom-rule (installed to /Users/admin/.agentjail/rules/tour-custom-rule.rego)\r\n  Run 'agentjail policy list' to see it under Custom.\r\n"]
[1.158, "o", "  -> exit 0\r\n"]
[1.169, "o", "   PASS  custom rule listed under Custom (tour-custom-rule)\r\n"]
