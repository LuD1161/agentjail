[6.558, "o", "  -> exit 0\r\n"]
[6.558, "o", "\r\n$ agentjail telemetry view (after disable)\r\n"]
[6.578, "o", "[\r\n  {\r\n    \"event\": \"feature_used\",\r\n    \"properties\": {\r\n      \"$insert_id\": \"f03950c1-3f5c-472f-a0dd-5e36aaeb10a1\",\r\n      \"agentjail_version\": \"dev-add2fa0a\",\r\n      \"command\": \"install\",\r\n      \"distinct_id\": \"51cdae1bf171ec42a34592a80e8b6d195ee5fddef5c5625ad94ce69adf482a8e\"\r\n    },\r\n    \"$set\": {\r\n      \"agentjail_version\": \"dev-add2fa0a\"\r\n    }\r\n  },\r\n  {\r\n    \"event\": \"policy_config\",\r\n    \"properties\": {\r\n      \"$insert_id\": \"8ac61c45-e6f2-4b57-b563-273447375a46\",\r\n      \"agentjail_version\": \"dev-add2fa0a\",\r\n      \"custom_rule_count\": 0,\r\n      \"disabled_rules\": null,\r\n      \"distinct_id\": \"51cdae1bf171ec42a34592a80e8b6d195ee5fddef5c5625ad94ce69adf482a8e\"\r\n    },\r\n"]
[6.579, "o", "  -> exit 0\r\n"]
[6.579, "o", "\r\n$ agentjail telemetry enable\r\n"]
[6.596, "o", "telemetry enabled\r\n"]
[6.596, "o", "  -> exit 0\r\n"]
[6.596, "o", "\r\n"]
[6.596, "o", "===================================================================\r\n"]
[6.596, "o", "  13. completion / help\r\n"]
[6.596, "o", "===================================================================\r\n"]
[6.597, "o", "\r\n$ agentjail completion bash (head)\r\n"]
[6.614, "o", "# bash completion V2 for agentjail                            -*- shell-script -*-\r\n\r\n__agentjail_debug()\r\n{\r\n    if [[ -n ${BASH_COMP_DEBUG_FILE-} ]]; then\r\n        echo \"$*\" >> \"${BASH_COMP_DEBUG_FILE}\"\r\n    fi\r\n}\r\n"]
[6.614, "o", "  -> exit 0\r\n"]
[6.614, "o", "\r\n$ agentjail help\r\n"]
[6.63, "o", "                                       \r\n  \u2588 \u2588 \u2588  AgentJail                     \r\n  \u2588 \u2588 \u2588  policy guardrails for agents  \r\n  \u2588 \u2588 \u2588  dev-add2fa0a \u00b7 darwin         \r\n                                       \r\n\r\n\u276f Usage\r\n  agentjail <command> [flags]\r\n\r\n\u276f Commands\r\n  allow             Request a runtime widening of this session's network egress\r\n  claude            Run Claude Code inside the agentjail shield\r\n  doctor            Check agentjail installation health\r\n  feedback          Send anonymous feedback to the maintainers\r\n  grant             Approve or deny a pending runtime host grant request\r\n  grants            List pending runtime host grant requests\r\n  install           Install hooks for supported coding agents\r\n  logs              View policy decisions\r\n  mcp               Manage MCP server allow/block lists\r\n  policy            Manage optional hardening rules\r\n  replay            Replay decisions from a saved session\r\n  run               Run a command inside the agentjail shield\r"]
[6.63, "o", "\r\n"]
[6.63, "o", "  -> exit 0\r\n"]
[6.631, "o", "\r\n===================================================================\r\n"]
[6.631, "o", "  14. ui \u2014 local web server (headless probe)\r\n"]
[6.631, "o", "===================================================================\r\n"]
[11.659, "o", "  ui log:\r\n"]
[11.664, "o", "    agentjail ui \u2014 dev-add2fa0a\r\n    serving on http://127.0.0.1:9101\r\n    press Ctrl-C to stop\r\n"]
[11.693, "o", "  GET http://127.0.0.1:9101/ -> HTTP 200\r\n"]
[11.7, "o", "   PASS  ui served HTTP 200 (<title>agentjail ui \u2014 dev tool)\r\n"]
[11.728, "o", "\r\n===================================================================\r\n  15. Not exercised unattended (reason stated)\r\n===================================================================\r\n  update   : replaces installed binaries from the network release channel;\r\n"]
[11.728, "o", "             would clobber the dev build under test. (--help now prints help \u2014 DEFECT-1 fixed)\r\n  claude   : launches an interactive Claude Code session; needs an OAuth token.\r\n  feedback : transmits a message to the maintainers (external side effect).\r\n\r\n===================================================================\r\n  16. uninstall --help safety (DEFECT-1 fixed) + real teardown\r\n===================================================================\r\n$ agentjail uninstall --help    (EXPECT: prints help, does NOT uninstall)\r\n"]
[11.746, "o", "Remove hooks, daemon service, and local policy state\r\n\r\nUsage:\r\n  agentjail uninstall [flags]\r\n\r\nFlags:\r\n"]
[11.751, "o", "   PASS  uninstall --help prints usage and left ~/.agentjail intact (DEFECT-1 fixed)\r\n"]
[11.751, "o", "$ agentjail uninstall    (real teardown \u2014 the box is re-provisioned by the harness)\r\n"]
[11.751, "o", "\r\n$ agentjail uninstall\r\n"]
[11.802, "o", "\r\n\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u2502 \ud83e\uddf9  uninstall summary                                                             \u2502\r\n\u2502 Claude Code         \u2713 unhooked                                                    \u2502\r\n\u2502 Cursor              \u2713 unhooked                                                    \u2502\r\n\u2502 Codex               \u2713 unhooked                                                    \u2502\r\n\u2502 daemon              \u2713 stopped and plist removed                                   \u2502\r\n\u2502 ~/.agentjail        \u2713 removed                                                     \u2502\r\n\u2502                                                                                   \u2502\r\n\u2502 \u2713 agentjail fully removed                                                         \u2502\r\n\u2502 \u2713 PATH: removed t"]
[11.802, "o", "he installer line from ~/.zshrc                                  \u2502\r\n\u2502 open a new shell (or unset PATH manually) for it to drop from the current session \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[11.803, "o", "  -> exit 0\r\n"]
