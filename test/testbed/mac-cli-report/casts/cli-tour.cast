[0.05, "o", "                                  \u001b[m\u001b[1m\u001b[33mLocale\u001b[m: \u001b[men_GB.UTF-8\r\n                                  \r\n                                  \u001b[m\u001b[40m   \u001b[41m   \u001b[42m   \u001b[43m   \u001b[44m   \u001b[45m   \u001b[46m   \u001b[47m   \u001b[m\r\n                                  \u001b[100m   \u001b[101m   \u001b[102m   \u001b[103m   \u001b[104m   \u001b[105m   \u001b[106m   \u001b[107m   \u001b[m\r\n\u001b[m"]
