[0.052, "o", "\r\n"]
[0.055, "o", "=== policy list ===\r\n"]
[0.075, "o", "\u276f Core Rules\r\n  \u2713 on                   aws_policy/posture                       Per-account AWS posture: sandbox asks on delete, prod denies delete, locked denies CUD; fails safe to prod\r\n  \u2713 on                   command_policy/no-sudo                   Block sudo invocations\r\n  \u2713 on                   command_policy/no-rm-rf-absolute         Block rm -rf on absolute paths\r\n  \u2713 on                   command_policy/no-git-push-force         Block git force-push to the default branch (main/master)\r\n  \u2713 on                   command_policy/no-chmod-777              Block chmod 777 / world-write operations\r\n  \u2713 on                   command_policy/no-dd-device-read         Block dd reads from raw block devices\r\n  \u2713 on                   command_policy/no-device-overwrite       Block writes to raw block/char devices\r\n  \u2713 on                   command_policy/no-env-exfil              Block environment-variable exfiltration via curl/wget\r\n  \u2713 on                   command_policy/no-gpg-secret-export    "]
[0.075, "o", "  Block GPG secret key export\r\n  \u2713 on                   command_policy/no-launchctl-remove       Block launchctl remove / unload of system services\r\n  \u2713 on                   command_policy/no-pipe-to-shell          Block curl/wget | sh pipe-to-shell patterns\r\n  \u2713 on                   command_policy/no-ssh-keygen-outside-tmp Block ssh-keygen writing keys outside /tmp\r\n  \u2713 on                   command_policy/no-systemctl-disrupt      Block systemctl stop/disable/mask on critical services\r\n  \u2713 on                   command_policy/no-bash-touch-sensitive-path Block bash touch/truncation of sensitive paths\r\n  \u2713 on                   command_policy/confirm-curl-download     Ask before downloading via curl (non-pipe)\r\n  \u2713 on                   command_policy/confirm-git-push          Ask before git push to a remote\r\n  \u2713 on                   command_policy/confirm-git-push-force    Ask before a force-push whose target branch is implicit (bare git push -f)\r\n  \u2713 on                   command_policy/confir"]
[0.075, "o", "m-publish           Ask before npm/cargo/pip publish\r\n"]
[0.075, "o", "  \u2713 on                   command_policy/default-allow             Allow commands that match no other rule\r\n  locked                 command_policy/no-policy-mutation        Block agents from running agentjail policy/mcp mutation commands\r\n  locked                 file_policy/agentjail_self               Block reads/writes to ~/.agentjail/ (agentjail self-protection)\r\n  \u2713 on                   file_policy/sensitive_credential         Deny access to SSH keys, AWS credentials, GPG keyrings, etc.\r\n  \u2713 on                   file_policy/sensitive_in_project         Deny access to .env / secrets files found in the project tree\r\n  \u2713 on                   file_policy/project_allow                Allow reads/writes within the project working directory\r\n  \u2713 on                   file_policy/temp_allow                   Allow reads/writes within the system temp directory\r\n  \u2713 on                   file_policy/default                      Default ask for file paths not matched by a more specific rule\r\n  \u2713 on     "]
[0.075, "o", "              mcp_policy/allowed                       Allow MCP tool calls to servers on the allow list\r\n"]
[0.075, "o", "  \u2713 on                   mcp_policy/blocked                       Deny MCP tool calls to servers on the block list\r\n  \u2713 on                   mcp_policy/tool_not_allowed              Deny MCP tool calls not in the per-server allowed_tools list\r\n"]
