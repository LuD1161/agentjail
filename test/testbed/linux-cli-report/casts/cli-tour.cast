[0.051799, "o", "\r\nHooks\r\n  [ok]  Hook binary                    /home/agent.guest/.agentjail/bin/agentjail-hook\r\n  [ok]  Claude Code                    hook installed\r\n\r\nLaunch Integration\r\n  [-]   PATH shim                      not installed (opt-in: agentjail install --with-path-shim)\r\n  [-]   Code wrapper                   Code not detected\r\n  [-]   Cursor wrapper                 Cursor not detected\r\n\r\nSSH\r\n  [!]   ssh-agent                      ssh keys on disk but not loaded in ssh-agent; the shield blocks key-file reads, so ssh needs the agent. Fix: eval \"$(ssh-agent -s)\" && ssh-add ~/.ssh/id_rsa\r\n\r\n"]
